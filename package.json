{
    "name": "docassist-monorepo",
    "version": "0.1.0",
    "description": "DocAssist: AI-powered documentation assistant for finding answers with RAG",
    "private": true,
    "workspaces": [
        "Backend",
        "Frontend"
    ],
    "scripts": {
        "install": "npm install",
        "build": "npm run build --workspaces",
        "dev": "npm run start:dev --workspace=Backend",
        "test": "npm test --workspaces",
        "lint": "npm run lint --workspaces",
        "format": "npm run format --workspaces"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}